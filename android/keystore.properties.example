# Release Keystore Configuration Template
# COPY this file to keystore.properties and fill in your real keystore details.
# DO NOT commit keystore.properties or keystore files (*.jks, *.keystore) to git!

storeFile=/path/to/your/release-keystore.jks
storePassword=your_keystore_password
keyAlias=your_key_alias
keyPassword=your_key_password
certSha256=A1B2C3D4E5F60718293A4B5C6D7E8F901234567890ABCDEF1234567890ABCDEF
