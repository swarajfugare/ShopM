rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Authoritative Owner Whitelist (Must strictly match GoogleAuthManager.AUTHORIZED_EMAILS and storage.rules)
    function isAuthorizedOwner() {
      return isAuthenticated() &&
        request.auth.token.firebase.sign_in_provider == 'google.com' &&
        request.auth.token.email_verified == true &&
        request.auth.token.email in ['swarajfugare23@gmail.com', 'sadhanafugare86@gmail.com'];
    }

    // Financial & Data Validation Helpers
    function isValidBill() {
      let data = request.resource.data;
      return (!('finalAmount' in data) || (data.finalAmount is number && data.finalAmount >= 0));
    }

    function isValidCustomer() {
      let data = request.resource.data;
      return (!('name' in data) || (data.name is string && data.name.size() > 0 && data.name.size() <= 120)) &&
             (!('mobile' in data) || (data.mobile is string && data.mobile.size() <= 20));
    }

    function isValidProduct() {
      let data = request.resource.data;
      return (!('name' in data) || (data.name is string && data.name.size() > 0 && data.name.size() <= 150)) &&
             (!('price' in data) || (data.price is number && data.price >= 0));
    }

    function isValidUdhari() {
      let data = request.resource.data;
      return (!('amount' in data) || (data.amount is number && data.amount >= 0));
    }

    function isValidGidFormat(prefix, gid) {
      return gid is string &&
        gid[0] == prefix[0] &&
        gid[1] == prefix[1] &&
        gid[2] == prefix[2] &&
        gid[3] == prefix[3] &&
        (gid.size() == 30 || (gid.size() >= 6 && gid[4] == 'L'));
    }

    function isValidGid(prefix, docId) {
      let data = request.resource.data;
      return !('gid' in data) || (
        isValidGidFormat(prefix, data.gid) &&
        (data.gid == docId || (data.gid.size() >= 6 && data.gid[4] == 'L'))
      );
    }

    function isImmutableOrOneTimeLegacyCorrection(prefix) {
      let hasOldGid = 'gid' in resource.data;
      let hasNewGid = 'gid' in request.resource.data;
      let existingGid = resource.data.gid;
      let newGid = request.resource.data.gid;
      return (!hasOldGid) ||
        (hasNewGid && (
          newGid == existingGid ||
          (
            existingGid.size() >= 6 &&
            existingGid[4] == 'L' &&
            isValidGidFormat(prefix, newGid)
          )
        ));
    }

    // 1. Shop Root & Member Authorization
    match /shops/{shopId} {
      allow read, write: if isAuthorizedOwner();

      match /{allChildren=**} {
        allow read, write: if isAuthorizedOwner();
      }
    }

    // 2. Customers Collection
    match /customers/{customerId} {
      allow read, delete: if isAuthorizedOwner();
      allow create: if isAuthorizedOwner() && isValidCustomer() && isValidGid('cus_', customerId);
      allow update: if isAuthorizedOwner() && isValidCustomer() && isImmutableOrOneTimeLegacyCorrection('cus_');
    }

    // 3. Products & Categories
    match /products/{productId} {
      allow read, delete: if isAuthorizedOwner();
      allow create: if isAuthorizedOwner() && isValidProduct() && isValidGid('prd_', productId);
      allow update: if isAuthorizedOwner() && isValidProduct() && isImmutableOrOneTimeLegacyCorrection('prd_');
    }

    match /categories/{categoryId} {
      allow read, delete: if isAuthorizedOwner();
      allow create: if isAuthorizedOwner() && isValidGid('cat_', categoryId);
      allow update: if isAuthorizedOwner() && isImmutableOrOneTimeLegacyCorrection('cat_');
    }

    // 4. Bills & Transactions
    match /bills/{billId} {
      allow read, delete: if isAuthorizedOwner();
      allow create: if isAuthorizedOwner() && isValidBill() && isValidGid('bil_', billId);
      allow update: if isAuthorizedOwner() && isValidBill() && isImmutableOrOneTimeLegacyCorrection('bil_');

      match /{allChildren=**} {
        allow read, write: if isAuthorizedOwner();
      }
    }

    // 5. Udhari Transactions Ledger
    match /udhari_transactions/{txId} {
      allow read, delete: if isAuthorizedOwner();
      allow create: if isAuthorizedOwner() && isValidUdhari() && (isValidGid('udh_', txId) || isValidGid('pay_', txId) || isValidGid('rev_', txId));
      allow update: if isAuthorizedOwner() && isValidUdhari() && (isImmutableOrOneTimeLegacyCorrection('udh_') || isImmutableOrOneTimeLegacyCorrection('pay_') || isImmutableOrOneTimeLegacyCorrection('rev_'));
    }

    // 6. Expenses & Daily Closings
    match /expenses/{expenseId} {
      allow read, delete: if isAuthorizedOwner();
      allow create: if isAuthorizedOwner() && isValidGid('exp_', expenseId);
      allow update: if isAuthorizedOwner() && isImmutableOrOneTimeLegacyCorrection('exp_');
    }

    match /daily_closings/{closingId} {
      allow read, delete: if isAuthorizedOwner();
      allow create: if isAuthorizedOwner() && isValidGid('clo_', closingId);
      allow update: if isAuthorizedOwner() && isImmutableOrOneTimeLegacyCorrection('clo_');
    }

    // 7. Stock Movements & Inventory Audit
    match /stock_movements/{movementId} {
      allow read, delete: if isAuthorizedOwner();
      allow create: if isAuthorizedOwner() && isValidGid('stk_', movementId);
      allow update: if isAuthorizedOwner() && isImmutableOrOneTimeLegacyCorrection('stk_');
    }

    // 8. Security, Devices, Settings & Diagnostics
    match /authorized_devices/{deviceId} {
      allow read, write: if isAuthorizedOwner();
    }

    match /settings/{settingDoc} {
      allow read, write: if isAuthorizedOwner();
    }

    match /security/{securityDoc} {
      allow read, write: if isAuthorizedOwner();
    }

    match /diagnostics/{diagDoc} {
      allow read, write: if isAuthorizedOwner();
    }

    // 9. Explicit Default Deny for unknown collections/documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
