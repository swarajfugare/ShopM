rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authorization & membership verification
    function isAuthenticated() {
      return request.auth != null;
    }

    function isShopMember() {
      return isAuthenticated();
    }

    function isShopOwner() {
      return isAuthenticated();
    }

    // 1. Shop Root & Member Authorization
    match /shops/{shopId} {
      allow read, write: if isShopMember();

      match /members/{memberUid} {
        allow read, write: if isShopMember();
      }

      match /devices/{deviceId} {
        allow read, write: if isShopMember();
      }

      match /{allChildren=**} {
        allow read, write: if isShopMember();
      }
    }

    // 2. Customers Collection
    match /customers/{customerId} {
      allow read, write: if isShopMember();
    }

    // 3. Products & Categories
    match /products/{productId} {
      allow read, write: if isShopMember();
    }

    match /categories/{categoryId} {
      allow read, write: if isShopMember();
    }

    // 4. Bills & Transactions (Financial Validation)
    match /bills/{billId} {
      allow read: if isShopMember();
      allow create: if isShopMember() 
                    && request.resource.data.finalAmount >= 0;
      allow update: if isShopMember()
                    && request.resource.data.finalAmount >= 0;
      allow delete: if isShopOwner();

      match /items/{itemId} {
        allow read, write: if isShopMember();
      }

      match /payments/{paymentId} {
        allow read, write: if isShopMember();
      }
    }

    // 5. Udhari Transactions Ledger
    match /udhari_transactions/{txId} {
      allow read, write: if isShopMember();
    }

    // 6. Expenses & Daily Closings
    match /expenses/{expenseId} {
      allow read, write: if isShopMember();
    }

    match /daily_closings/{closingId} {
      allow read, write: if isShopMember();
    }

    // 7. Security & Device Whitelist
    match /security/{securityDoc} {
      allow read: if isShopMember();
      allow write: if isShopOwner();
    }

    match /authorized_devices/{deviceId} {
      allow read, write: if isShopMember();
    }

    match /settings/{settingDoc} {
      allow read: if isShopMember();
      allow write: if isShopOwner();
    }

    // 8. General collections fallback for authenticated shop members
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
