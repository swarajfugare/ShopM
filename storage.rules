rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Authoritative Owner Whitelist (Must strictly match GoogleAuthManager.AUTHORIZED_EMAILS and firestore.rules)
    function isAuthorizedOwner() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['swarajfugare23@gmail.com', 'sadhanafugare86@gmail.com'];
    }

    match /shops/{shopId}/branding/{fileName} {
      allow read: if isAuthorizedOwner();
      allow write: if isAuthorizedOwner()
                   && shopId == 'matoshree_collection'
                   && request.resource.size < 5 * 1024 * 1024
                   && (request.resource.contentType == 'image/png' 
                       || request.resource.contentType == 'image/jpeg' 
                       || request.resource.contentType == 'image/webp');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
